# Prepared EA values. Copy only during an explicitly authorized EA deployment.
# Never copy SG OAuth databases, recovery credentials or keys to EA.
VRCH_MCP_IMAGE=vrch-mcp:hosted-0.1.0
VRCH_MCP_ISSUER=https://mcp.vrch.ai
VRCH_MCP_DEVICE_ISSUER=vrch-device-manager-ea
VRCH_MCP_DIRECTORY_URL=http://127.0.0.1:18085/v1/public/server-directory
VRCH_MCP_STATE_DIR=/var/lib/vrch-mcp-synth-ea
VRCH_MCP_RECOVERY_KEY_FILE=/etc/vrch-mcp/synth-ea-recovery-key
VRCH_MCP_VERIFY_KEY_FILE=/etc/vrch-mcp/device-ea-public.pem
VRCH_MCP_SDK_VALIDATION=false
# Browser-only Playground onboarding is outside this initial device-backed release.
VRCH_MCP_BROWSER_ORIGINS=
